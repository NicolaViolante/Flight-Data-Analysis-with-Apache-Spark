# ==========================================
# Variabili d'ambiente per il Progetto SABD
# ==========================================

# Apache NiFi (La password deve avere almeno 12 caratteri)
NIFI_USER=nicolaviolante
NIFI_PASS=nicolaviolantepassword

# InfluxDB
INFLUX_USER=nicolaviolante
INFLUX_PASS=nicolaviolantepassword
INFLUX_TOKEN=nicolaviolanteToken

# Grafana
GRAFANA_USER=nicolaviolante
GRAFANA_PASS=nicolaviolantepassword

# Grafana Renderer Token (Una password casuale)
RENDERER_TOKEN=nicolaviolanteToken