      "title": "Query1 - Mean Departure Delay",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "InfluxDB"
      },
      "targets": [
        {
          "query": "from(bucket: \"query_results\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"query1_csv_df\")\n  |> filter(fn: (r) => r[\"_field\"] == \"dep_delay_mean\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "auto",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "dep_delay_mean AA"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "AA"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dep_delay_mean DL"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "DL"
              }
            ]
          }
        ]
      }
